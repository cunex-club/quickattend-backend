# Application environment (development, staging, production)
APP_ENV=development

# Database configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASS=postgres
POSTGRES_DB=quickattend-db
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=disable

JWT_SECRET=your_jwt_secret_key_here
FRONTEND_HOME_URL=http://localhost:3000/
ALLOWED_ORIGINS=http://localhost:3000

# CU NEX credentials. One pair serves both /profile and qrcodeinfo_for_all.
LLE_CLIENT_ID=
LLE_CLIENT_SECRET=

# Optional. Only set these if CU NEX issues a separate credential for reading
# QR codes; otherwise the pair above is used for that too.
# LLE_QR_CLIENT_ID=
# LLE_QR_CLIENT_SECRET=
